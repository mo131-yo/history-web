{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
, "../old_seed_backup/seed-rings.ts", "../old_seed_backup/seed-rings-b.ts", "../old_seed_backup/seed-rings-a.ts", "../old_seed_backup/seed-data.ts", "../old_seed_backup/seed-data-d2.ts", "../old_seed_backup/seed-data-d1.ts", "../old_seed_backup/seed-data-d.ts", "../old_seed_backup/seed-data-c2.ts", "../old_seed_backup/seed-data-c1.ts", "../old_seed_backup/seed-data-c.ts", "../old_seed_backup/seed-data-b2.ts", "../old_seed_backup/seed-data-b1.ts", "../old_seed_backup/seed-data-a2.ts", "../old_seed_backup/seed-data-a1.ts", "../old_seed_backup/seed-data-a.ts"  ],
  "exclude": [
    "node_modules"
  ]
}
